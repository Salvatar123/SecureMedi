# SecureMedi Environment Variables
# Copy this file to .env and fill in your values

# ============== ENVIRONMENT ==============
# Options: development, staging, production
ENVIRONMENT=development

# ============== BLOCKCHAIN ==============
# Ganache RPC endpoint
GANACHE_URL=http://127.0.0.1:7545

# Smart contract address on blockchain
# You must deploy the contract first and add its address here
CONTRACT_ADDRESS=0x9feb5BA604B3C467Cd07Ecd20a9d8d601a2D98Fd

# Private key of the account executing transactions
# WARNING: Never commit this to version control!
# Use only the first account from Ganache for development
PRIVATE_KEY=0x4f531878d488cb41e18550a0ac6fd76e16531616fef79972b098bc00548d4c51

# Gas configuration
GAS_LIMIT=3000000
GAS_PRICE_GWEI=20

# ============== LOGGING ==============
# Path to CSV file for storing health data
LOG_FILE=logs/data.csv

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============== DETECTOR THRESHOLDS ==============
# Anomaly detection thresholds
HEART_RATE_MAX=110
TEMPERATURE_MAX=38.0
SPO2_MIN=92

# ============== SENSOR ==============
# Sensor data generation parameters (for testing)
SENSOR_INTERVAL_SEC=5
HEART_RATE_MIN=60
HEART_RATE_MAX_RANGE=130
TEMPERATURE_MIN=36.0
TEMPERATURE_MAX_RANGE=39.5
SPO2_MIN_RANGE=88
SPO2_MAX_RANGE=100

# ============== PATIENT ==============
# Default patient ID if none specified
DEFAULT_PATIENT_ID=P001

# ============== FEATURE FLAGS ==============
# Enable/disable blockchain operations
ENABLE_BLOCKCHAIN=true

# Enable/disable local CSV logging
ENABLE_LOCAL_LOGGING=true
